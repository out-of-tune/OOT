{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "schema/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "schema/**/*.test.ts", "schema/testcases/**"]
}
