{
  "name": "oot-api",
  "version": "1.0.0",
  "description": "API for the oot webapp",
  "main": "./dist/src/index.js",
  "scripts": {
    "codegen": "graphql-codegen --config src/codegen.ts",
    "compile": "tsc && mkdir -p dist/schema && cp schema/schema.graphql dist/schema/",
    "build": "npm run codegen && npm run compile",
    "start": "node ./dist/src/index.js",
    "serve": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "type": "module",
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@apollo/cache-control-types": "^1.0.3",
    "@apollo/server": "^5.5.1",
    "@apollo/server-plugin-response-cache": "^5.0.0",
    "@apollo/utils.keyvadapter": "^4.0.1",
    "@graphql-tools/schema": "^10.1.1",
    "@keyv/memcache": "^2.0.2",
    "arangojs": "^10.5.0",
    "dataloader": "^2.2.3",
    "dotenv": "^18.0.3",
    "graphql": "^16.14.2",
    "keyv": "^5.6.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@graphql-tools/mock": "^9.1.14",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
