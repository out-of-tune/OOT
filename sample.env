# change secret:
JWT_SECRET=htl
APP_MOUNT_PATH=/app/

ARANGODB_USER=root
ARANGODB_PASSWORD=htl
ARANGODB_DATABASE=test
ARANGODB_VOLUME=~/arangodb/

SPOTIFY_CLIENT_ID="<spotify client id>"
SPOTIFY_CLIENT_SECRET="<spotify client secret>"
SPOTIFY_SCOPE="streaming user-read-email user-read-private user-read-playback-state user-modify-playback-state user-read-currently-playing user-library-read user-library-modify user-top-read user-read-recently-played user-follow-read user-follow-modify playlist-read-private playlist-read-collaborative playlist-modify-public playlist-modify-private"

VITE_PROXY_URI=http://localhost
# Pages that may call the auth service with their cookies, besides VITE_PROXY_URI.
# Space separated. docker-compose.override.yml adds the Vite dev server (port 8080) when this is empty.
AUTH_CORS_ORIGINS=
PROXY_ERROR_LOG_LOC=./nginx/error.log
PROXY_CACHE_LOC=./nginx/cache/

# For built in https and letsencrypt certificate:
# 1 -> use letsencrypt and https; 0 -> no encryption
PROXY_USE_CERT=1
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443
PROXY_LETSENCRYPT_LOC=./nginx/letsencrypt/
PROXY_DOMAIN="<domain of the proxy; required for https>"
ADMIN_EMAIL="<your-email>"

# docker-compose.yml sets SHARE_LOC to its share_data volume. This value is for running the service without Docker.
SHARE_LOC=./data
SHARE_TYPES="graph settings"

# Host names of the dev stack besides localhost, IP addresses and the host of VITE_PROXY_URI.
# Space separated. The Vite dev server answers other hosts with 403.
DEV_ALLOWED_HOSTS=

# Environment:
# development | production | test (?)
NODE_ENV=development

# modify this config and rename to .env
# place in same directory with docker-compose.yml
