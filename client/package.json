{
  "name": "oot_client",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "serve": "vite",
    "build": "vite build --base=${BASE_URL:-/}",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "generate:parser": "antlr-ng -Dlanguage=TypeScript -o src/lib/search/antlr src/lib/search/antlr/AdvancedSearch.g4 && node scripts/mark-generated.mjs src/lib/search/antlr"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@lucide/vue": "^1.48.0",
    "3d-force-graph": "^1.80.0",
    "antlr4ng": "^3.0.16",
    "axios": "^1.20.0",
    "driver.js": "^1.8.0",
    "jsonschema": "^1.5.0",
    "lodash-es": "^4.18.1",
    "ngraph.cw": "^2.0.0",
    "ngraph.graph": "0.0.15",
    "pako": "^3.0.2",
    "three": "^0.186.1",
    "vivagraphjs": "0.12.0",
    "vue": "^3.5.43",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.3.1",
    "vuex": "^4.1.0",
    "vuex-persist": "^3.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/lodash": "^4.17.25",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "antlr-ng": "^1.0.10",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.1",
    "lodash": "^4.18.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
